{
  "encoder": "speechtokenizer",
  "task": "asr",
  "model": {
    "speechtokenizer_ckpt_path": "./models/speechtokenizer/SpeechTokenizer.pt",
    "speechtokenizer_config_path": "./models/speechtokenizer/config.json",
    "llama_ckpt_path": "./models/Llama-3.2-1B"
  },
  "data": {
    "train": {
      "scp": "./data/packed/train/audio.scp",
      "text": "./data/packed/train/text.txt"
    },
    "val": {
      "scp": "./data/packed/val/audio.scp",
      "text": "./data/packed/val/text.txt"
    },
    "test": {
      "scp": "./data/packed/test/audio.scp",
      "text": "./data/packed/test/text.txt"
    }
  },
  "output_dir": "./runs/uniarc/speechtokenizer/asr",
  "batch_size": 8,
  "num_workers": 0,
  "seed": 3407,
  "learning_rate": 1e-05,
  "trainer": {
    "max_epochs": 150,
    "accelerator": "gpu",
    "devices": 1,
    "precision": "bf16-mixed",
    "accumulate_grad_batches": 4
  },
  "external_source_dirs": [
    "./external/SpeechTokenizer"
  ]
}
